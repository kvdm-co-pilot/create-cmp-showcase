-/** Serials of devices currently in `device` state (same parse as deviceAttached). */
-function attachedDeviceSerials() {
-  const res = sh("adb devices", { timeout: 10_000 });
-  if (!res.ok) return [];
-  return res.out
-    .split("\n")
-    .slice(1)
-    .map((l) => l.trim())
-    .filter(Boolean)
-    .map((l) => l.split(/\s+/))
-    .filter(([, state]) => state === "device")
-    .map(([serial]) => serial);
-}
